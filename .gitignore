# CMake build trees and generated files.
# Any root-level "build-<name>/" directory is treated as a disposable CMake
# tree. Do not use this prefix for cloned reference material that isn't an
# actual build output -- it will be silently ignored and can look disposable
# when it is not.
/build*/
/out/
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
cmake_install.cmake
Makefile
Testing/

# Visual Studio and editor state
/.vs/
/.vscode/
/.idea/
CMakeUserPresets.json
*.suo
*.user
*.VC.db
*.VC.VC.opendb

# Compiled artifacts
*.obj
*.o
*.lib
*.a
*.dll
*.exe
*.exp
*.ilk
*.pdb

# vcpkg local state
/vcpkg_installed/
/installed/

# Local diagnostics and hardware captures
*.jsonl
*.log
*.tmp

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Agent-to-agent handoff prompts (docs/prompts/00N-*.md). Kept locally as a
# working record between coding sessions, but deliberately excluded from the
# published repository so the public history/tree only contains what a
# human developer needs to continue the project.
/docs/prompts/
